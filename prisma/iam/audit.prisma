model AuditLog {
  id String @id @default(uuid())

  tenantId String?
  userId String?

  entityName String
  entityId String?

  action String

  oldData Json?
  newData Json?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([entityName])
  @@index([entityId])
  @@index([entityName, entityId])

  @@map("audit_logs")
}