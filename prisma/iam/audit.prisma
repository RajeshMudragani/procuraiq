enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  PUBLISH
  AWARD
  ISSUE
  CANCEL
}

model AuditLog {
  id String @id @default(uuid())

  tenantId String?

  userId String?

  entityType String

  entityId String?

  action AuditAction

  oldData Json?

  newData Json?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([tenantId])

  @@index([userId])

  @@index([entityType])

  @@index([entityId])

  @@index([entityType, entityId])

  @@map("audit_logs")
}