model Tenant {
    id String @id @default(uuid())

    name String @unique
    code String @unique

    isActive Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    createdBy String?
    updatedBy String?

    isDeleted Boolean @default(false)

    deletedAt DateTime?
    deletedBy String?

    version Int @default(1)

    users User[]

    @@index([code])
    @@map("tenants")
}