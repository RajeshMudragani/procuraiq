model OutboxMessage {
  id String @id @default(uuid())

  eventType String

  routingKey String

  payload Json

  status String

  retryCount Int @default(0)

  processedAt DateTime?

  errorMessage String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("outbox_messages")
}
