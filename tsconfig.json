{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "sourceMap": true,
    "declaration": true,

    "incremental": true,
    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "outDir": "./dist"
  }
}